<script>
const isMob = window.matchMedia && window.matchMedia('(max-width:780px)').matches;

function scrollToTop(e) {
  e.preventDefault();
  window.scrollTo({ top: 0, behavior: 'smooth' });
  setNavActive(0);
}
function scrollToSection(e, id) {
  e.preventDefault();
  const el = document.getElementById(id);
  if (el) {
    const offset = 58;
    const top = el.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top, behavior: 'smooth' });
  }
  const idx = { recoverySection: 1, distSection: 2, chartsSection: 3 };
  setNavActive(idx[id] ?? 0);
}
function setNavActive(idx) {
  document.querySelectorAll('.mob-nav-item').forEach((el, i) => {
    el.classList.toggle('active', i === idx);
  });
}

/* THEME */
const btn  = document.getElementById('themeBtn');
const ico  = document.getElementById('themeIco');
const html = document.documentElement;

function applyTheme(t) {
  html.setAttribute('data-theme', t);
  ico.className = t === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon';
  localStorage.setItem('umeed-theme', t);
  if (window._rc) refreshCharts();
}

applyTheme(localStorage.getItem('umeed-theme') || 'light');
btn.addEventListener('click', () =>
  applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark')
);

/* FLASK DATA */
const rL = {{ labels|default([])|tojson }};
const rD = {{ amounts|default([])|tojson }};
const dL = {{ dist_labels|default([])|tojson }};
const dD = {{ dist_amounts|default([])|tojson }};

/* STATE */
const now    = new Date();
const rState = { period: 'year', year: now.getFullYear(), month: now.getMonth() };
const dState = { period: 'year', year: now.getFullYear(), month: now.getMonth() };

/* HELPERS */
const MONTHS     = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONTH_FULL = ['January','February','March','April','May','June','July','August','September','October','November','December'];

function getYears(labels) {
  const ys = new Set();
  labels.forEach(l => { const y = new Date(l).getFullYear(); if (!isNaN(y)) ys.add(y); });
  ys.add(now.getFullYear());
  return [...ys].sort();
}

function weekKey(s) {
  const d = new Date(s + 'T00:00:00');
  const day = d.getDay();
  const diff = (day === 0) ? -6 : 1 - day;
  const mon = new Date(d);
  mon.setDate(d.getDate() + diff);
  const y  = mon.getFullYear();
  const m  = String(mon.getMonth() + 1).padStart(2, '0');
  const dd = String(mon.getDate()).padStart(2, '0');
  return `${y}-${m}-${dd}`;
}

function weekLabel(key) {
  const d = new Date(key + 'T00:00:00');
  const sun = new Date(d); sun.setDate(d.getDate() + 6);
  return `${d.getDate()} ${MONTHS[d.getMonth()]}–${sun.getDate()} ${MONTHS[sun.getMonth()]}`;
}

function fk(n) {
  if (n >= 1e6) return (n / 1e6).toFixed(1) + 'M';
  if (n >= 1e3) return (n / 1e3).toFixed(0) + 'K';
  return n.toLocaleString();
}

/* AGGREGATION */
function aggFull(rawL, rawD, period, year, month) {
  if (period === 'year') {
    const buckets = {};
    rawL.forEach((l, i) => {
      const d = new Date(l + 'T00:00:00');
      if (d.getFullYear() === year) {
        const k = d.getMonth();
        buckets[k] = (buckets[k] || 0) + (rawD[i] || 0);
      }
    });
    return { labels: MONTHS.slice(), data: MONTHS.map((_, idx) => buckets[idx] || 0) };
  }
  if (period === 'month') {
    const buckets = {};
    rawL.forEach((l, i) => {
      const d = new Date(l + 'T00:00:00');
      if (d.getFullYear() === year && d.getMonth() === month) {
        const day = d.getDate();
        buckets[day] = (buckets[day] || 0) + (rawD[i] || 0);
      }
    });
    const daysInMonth = new Date(year, month + 1, 0).getDate();
    const labels = [], data = [];
    for (let day = 1; day <= daysInMonth; day++) {
      labels.push(String(day));
      data.push(buckets[day] || 0);
    }
    return { labels, data };
  }
  if (period === 'week') {
    const buckets = {};
    rawL.forEach((l, i) => {
      const d = new Date(l + 'T00:00:00');
      if (d.getFullYear() === year) {
        const k = weekKey(l);
        buckets[k] = (buckets[k] || 0) + (rawD[i] || 0);
      }
    });
    const keys = Object.keys(buckets).sort();
    return { labels: keys.map(weekLabel), data: keys.map(k => buckets[k]) };
  }
  if (period === 'day') {
    const outL = [], outD = [];
    rawL.forEach((l, i) => {
      const d = new Date(l + 'T00:00:00');
      if (d.getFullYear() === year) {
        outL.push(`${d.getDate()} ${MONTHS[d.getMonth()]}`);
        outD.push(rawD[i] || 0);
      }
    });
    return { labels: outL, data: outD };
  }
  return { labels: rawL, data: rawD };
}

/* CHART THEME */
function dark() { return html.getAttribute('data-theme') === 'dark'; }
function gc()   { return dark() ? 'rgba(255,255,255,0.05)' : 'rgba(15,30,70,0.05)'; }
function tc()   { return dark() ? '#4a5d7a' : '#a0aec0'; }
function tbg()  { return dark() ? '#0f1525' : '#ffffff'; }
function tbc()  { return dark() ? 'rgba(255,255,255,0.08)' : 'rgba(15,30,70,0.10)'; }

/* BUILD CHART */
function mkChart(id, hexColor) {
  const canvas = document.getElementById(id);
  const ctx    = canvas.getContext('2d');

  function makeGrad(h) {
    const wrapH = canvas.parentElement.clientHeight || 260;
    const g = ctx.createLinearGradient(0, 0, 0, wrapH);
    g.addColorStop(0,   h + '55');
    g.addColorStop(0.5, h + '22');
    g.addColorStop(1,   h + '00');
    return g;
  }

  const chart = new Chart(ctx, {
    type: 'bar',
    data: {
      labels: [],
      datasets: [{
        data: [], label: '',
        backgroundColor:      makeGrad(hexColor),
        borderColor:          hexColor,
        borderWidth:          0,
        borderRadius:         8,
        borderSkipped:        false,
        hoverBackgroundColor: hexColor + '99',
        hoverBorderColor:     hexColor,
        hoverBorderWidth:     0,
        barPercentage:        0.65,
        categoryPercentage:   0.80,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 500, easing: 'easeOutQuart' },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: tbg(),
          titleColor:      dark() ? '#6b85a8' : '#4b5874',
          bodyColor:       dark() ? '#e8eeff' : '#0b1120',
          borderColor:     tbc(),
          borderWidth:     1,
          titleFont:  { family: 'Plus Jakarta Sans', size: 11, weight: '700' },
          bodyFont:   { family: 'JetBrains Mono', size: 14, weight: '600' },
          padding:    { top: 12, bottom: 12, left: 16, right: 16 },
          cornerRadius:  12,
          displayColors: false,
          callbacks: {
            title: items => items[0].label || '',
            label: c  => 'Rs ' + c.parsed.y.toLocaleString()
          }
        }
      },
      scales: {
        x: {
          grid:   { display: false },
          border: { display: false },
          ticks:  {
            display: true, color: tc(),
            maxRotation: 0, minRotation: 0, padding: 6,
            font: { family: 'JetBrains Mono', size: 10, weight: '600' },
            autoSkip: true, maxTicksLimit: 12
          }
        },
        y: {
          beginAtZero: true,
          grid:   { color: gc(), lineWidth: 1, drawBorder: false },
          border: { display: false, dash: [4, 4] },
          ticks:  {
            color: tc(),
            font: { family: 'JetBrains Mono', size: 10, weight: '500' },
            callback: v => fk(v), maxTicksLimit: 6, padding: 8
          }
        }
      }
    }
  });

  chart._hexColor = hexColor;
  chart._makeGrad = makeGrad;
  return chart;
}

/* UPDATE CHART */
function updateChart(chart, rawL, rawD, state, statIds, scrollOuterId, scrollInnerId, scrollHintId) {
  const a     = aggFull(rawL, rawD, state.period, state.year, state.month);
  const outer = document.getElementById(scrollOuterId);
  const inner = document.getElementById(scrollInnerId);
  const hint  = document.getElementById(scrollHintId);

  const outerW = outer.getBoundingClientRect().width || 400;
  const n = a.labels.length;
  let finalW, scrollable;

  if (state.period === 'year' || state.period === 'month') {
    finalW     = outerW;
    scrollable = false;
    chart.options.scales.x.ticks.autoSkip      = false;
    chart.options.scales.x.ticks.maxTicksLimit  = 31;
    chart.options.scales.x.ticks.font.size      = state.period === 'year' ? 10 : 9;
  } else {
    const VISIBLE  = Math.max(20, Math.min(n, 30));
    const pxPerBar = outerW / VISIBLE;
    finalW      = Math.max(outerW, n * pxPerBar);
    scrollable  = finalW > outerW + 4;
    chart.options.scales.x.ticks.autoSkip      = true;
    chart.options.scales.x.ticks.maxTicksLimit  = 14;
    chart.options.scales.x.ticks.font.size      = 9;
  }

  inner.style.width    = finalW + 'px';
  inner.style.minWidth = '100%';

  if (scrollable) { hint.classList.add('visible'); }
  else { hint.classList.remove('visible'); outer.scrollLeft = 0; }

  chart.data.labels           = a.labels;
  chart.data.datasets[0].data = a.data;
  chart.data.datasets[0].backgroundColor = chart._makeGrad(chart._hexColor);
  chart.update('active');

  const tot = a.data.reduce((x, y) => x + y, 0);
  const pk  = Math.max(...a.data, 0);
  const avg = a.data.length ? Math.round(tot / a.data.length) : 0;
  const viewLabels = { day: 'Daily', week: 'Weekly', month: 'Monthly', year: 'Yearly' };

  document.getElementById(statIds[0]).textContent = fk(tot);
  document.getElementById(statIds[1]).textContent = fk(pk);
  document.getElementById(statIds[2]).textContent = fk(avg);
  document.getElementById(statIds[3]).textContent = viewLabels[state.period];
}

