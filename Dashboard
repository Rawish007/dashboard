/* COUNT-UP ANIMATION */
document.querySelectorAll('.val, .ao-val, .mob-hero-val, .dh-val').forEach(el => {
  const raw = el.textContent.replace(/,/g, '').replace('%', '').replace('+', '');
  const num = parseFloat(raw);
  if (isNaN(num) || num === 0) return;
  const dur = 900, step = 14;
  const inc = num / (dur / step);
  let cur = 0;
  const t = setInterval(() => {
    cur = Math.min(cur + inc, num);
    el.textContent = Math.floor(cur).toLocaleString();
    if (cur >= num) clearInterval(t);
  }, step);
});

