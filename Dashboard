/* ── Smart Notification System ── */
const notifStore = [];

function pushNotif(ico, title, body, type) {
  notifStore.unshift({ ico, title, body, type, time: 'Just now', read: false });
}

function buildSmartNotifs() {
  const r = aiData.recovery, d = aiData.distribution;

  if (r.yesterday > 0) {
    const pct = Math.round(((r.today - r.yesterday) / r.yesterday) * 100);
    if (pct >= 10)
      pushNotif('fa-solid fa-arrow-trend-up', 'Recovery Rising',
        `Today is ${pct}% higher than yesterday — Rs ${fk(r.today)} vs Rs ${fk(r.yesterday)}`, 'nup');
    else if (pct <= -15)
      pushNotif('fa-solid fa-arrow-trend-down', 'Recovery Drop',
        `Today's recovery dropped ${Math.abs(pct)}% vs yesterday. Attention needed.`, 'ndown');
  }

  if (r.lastWeek > 0) {
    const pct = Math.round(((r.thisWeek - r.lastWeek) / r.lastWeek) * 100);
    if (pct > 0)
      pushNotif('fa-solid fa-calendar-week', 'Weekly Growth',
        `This week's recovery is up ${pct}% compared to last week.`, 'nup');
    else if (pct < -10)
      pushNotif('fa-solid fa-calendar-week', 'Weekly Decline',
        `Weekly recovery is down ${Math.abs(pct)}% vs last week.`, 'nwarn');
  }

  if (r.lastMonth > 0) {
    const pct = Math.round(((r.thisMonth - r.lastMonth) / r.lastMonth) * 100);
    if (pct > 0)
      pushNotif('fa-solid fa-calendar-check', 'Monthly Improvement',
        `Month-over-month recovery grew by ${pct}%.`, 'nup');
    else
      pushNotif('fa-solid fa-calendar-days', 'Monthly Trend',
        `This month is ${Math.abs(pct)}% below last month's recovery.`, 'nwarn');
  }

  if (r.allTime > 0 && d.allTime > 0) {
    const ratio = Math.round((d.allTime / r.allTime) * 100);
    if (ratio > 90)
      pushNotif('fa-solid fa-exclamation-triangle', 'High Distribution Ratio',
        `Distribution is ${ratio}% of total recovery — monitor fund balance.`, 'nwarn');
    else
      pushNotif('fa-solid fa-shield-halved', 'Healthy Fund Balance',
        `Distribution ratio is ${ratio}% of total recovery. Sustainable level.`, 'ninfo');
  }

  if (r.bestDay > 0 && r.today >= r.bestDay * 0.88)
    pushNotif('fa-solid fa-trophy', 'Near Record Day!',
      `Today Rs ${fk(r.today)} is approaching the all-time record Rs ${fk(r.bestDay)}!`, 'nup');

  if (d.bestDay > 0 && d.today >= d.bestDay * 0.8)
    pushNotif('fa-solid fa-truck-fast', 'High Distribution Day',
      `Today's distribution Rs ${fk(d.today)} is near the record high.`, 'ninfo');

  renderNotifs();
}

function renderNotifs() {
  const list  = document.getElementById('notifList');
  const badge = document.getElementById('notifBadge');
  const empty = document.getElementById('notifEmpty');
  const count = document.getElementById('notifCount');

  const unread = notifStore.filter(n => !n.read).length;
  if (unread > 0) {
    badge.textContent = unread > 9 ? '9+' : unread;
    badge.style.display = 'flex';
  } else {
    badge.style.display = 'none';
  }

  count.textContent = notifStore.length ? `${notifStore.length} alerts` : '';
  list.querySelectorAll('.notif-item').forEach(el => el.remove());
  empty.style.display = notifStore.length === 0 ? 'block' : 'none';

  notifStore.forEach(n => {
    const el = document.createElement('div');
    el.className = 'notif-item' + (n.read ? '' : ' unread');
    el.innerHTML = `
      <div class="notif-ico ${n.type}"><i class="${n.ico}"></i></div>
