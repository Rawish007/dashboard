{% extends "base.html" %}
{% block title %}Dashboard — UMEED{% endblock %}

{% block content %}

<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>

<style>
:root {
  --bg:          #eef2f9;
  --bg2:         #e4eaf4;
  --surface:     #ffffff;
  --surface2:    #f5f8fc;
  --border:      rgba(15,30,70,0.07);
  --sh-xs:       0 1px 2px rgba(0,0,0,.04);
  --sh-sm:       0 2px 8px rgba(15,30,70,.06), 0 0 0 1px rgba(15,30,70,.04);
  --sh-md:       0 6px 24px rgba(15,30,70,.10), 0 1px 4px rgba(15,30,70,.06);
  --sh-lg:       0 16px 48px rgba(15,30,70,.14);
  --text-h:      #0b1120;
  --text-p:      #4b5874;
  --text-m:      #8c99b0;
  --r:           14px;
  --r-lg:        20px;
}

[data-theme="dark"] {
  --bg:          #090e1a;
  --bg2:         #0f1525;
  --surface:     #141b2d;
  --surface2:    #1a2236;
  --border:      rgba(255,255,255,0.07);
  --sh-xs:       0 1px 2px rgba(0,0,0,.3);
  --sh-sm:       0 2px 8px rgba(0,0,0,.4), 0 0 0 1px rgba(255,255,255,.04);
  --sh-md:       0 6px 24px rgba(0,0,0,.5), 0 1px 4px rgba(0,0,0,.3);
  --sh-lg:       0 16px 48px rgba(0,0,0,.6);
  --text-h:      #e8eeff;
  --text-p:      #7a8ba8;
  --text-m:      #3d4d68;
}

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { overflow-x: hidden; }

body {
  font-family: 'Plus Jakarta Sans', sans-serif;
  background: var(--bg);
  color: var(--text-h);
  transition: background .35s ease, color .35s ease;
}

.dash {
  padding: 28px 30px 80px;
  max-width: 1480px;
  overflow-x: hidden;
}

/* ── TOPBAR ── */
.topbar {
  display: flex; align-items: center;
  justify-content: space-between;
  margin-bottom: 34px;
  gap: 16px; flex-wrap: wrap;
}

.brand { display: flex; align-items: center; gap: 16px; }

.brand-logo {
  width: 52px; height: 52px;
  border-radius: 16px;
  background: linear-gradient(140deg, #1d4ed8 0%, #7c3aed 100%);
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; color: #fff;
  box-shadow: 0 8px 24px rgba(37,99,235,.38), 0 0 0 1px rgba(255,255,255,.12) inset;
  flex-shrink: 0; position: relative;
}
.brand-logo::after {
  content: ''; position: absolute; inset: 0; border-radius: 16px;
  background: linear-gradient(180deg, rgba(255,255,255,.18) 0%, transparent 55%);
  pointer-events: none;
}

.brand-text h1 { font-size: 22px; font-weight: 800; color: var(--text-h); letter-spacing: -.4px; }
.brand-text p  { font-size: 12.5px; color: var(--text-m); margin-top: 3px; font-weight: 500; }

.topbar-actions { display: flex; align-items: center; gap: 10px; }

.live-badge {
  display: flex; align-items: center; gap: 8px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 50px; padding: 9px 18px;
  font-size: 12px; font-weight: 600; color: var(--text-p);
  box-shadow: var(--sh-sm);
}

.live-dot {
  width: 8px; height: 8px; border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34,197,94,.2);
  animation: blink 1.5s infinite;
}

@keyframes blink { 0%,100%{opacity:1} 50%{opacity:.3} }

.icon-btn {
  width: 42px; height: 42px; border-radius: 12px;
  background: var(--surface); border: 1px solid var(--border);
  color: var(--text-p); font-size: 15px; cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  box-shadow: var(--sh-sm); transition: all .2s ease; text-decoration: none;
}
.icon-btn:hover {
  background: var(--surface2); transform: translateY(-1px);
  box-shadow: var(--sh-md); color: var(--text-h);
}
.logout-btn:hover { color: #dc2626 !important; border-color: rgba(220,38,38,0.25) !important; }

/* ── SECTION HEADER ── */
.sec-head {
  display: flex; align-items: center; gap: 12px;
  margin: 30px 0 16px;
}

.sec-ico {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; color: #fff; flex-shrink: 0; position: relative;
}
.sec-ico::after {
  content: ''; position: absolute; inset: 0; border-radius: 10px;
  background: linear-gradient(180deg, rgba(255,255,255,.22) 0%, transparent 60%);
  pointer-events: none;
}

.ico-blue   { background: linear-gradient(135deg,#1d4ed8,#60a5fa); box-shadow:0 4px 14px rgba(29,78,216,.38); }
.ico-red    { background: linear-gradient(135deg,#b91c1c,#f87171); box-shadow:0 4px 14px rgba(185,28,28,.38); }
.ico-green  { background: linear-gradient(135deg,#047857,#34d399); box-shadow:0 4px 14px rgba(4,120,87,.38); }
.ico-violet { background: linear-gradient(135deg,#6d28d9,#a78bfa); box-shadow:0 4px 14px rgba(109,40,217,.38); }

.sec-title { font-size: 13.5px; font-weight: 700; color: var(--text-h); letter-spacing: .2px; }
.sec-line  { flex: 1; height: 1px; background: var(--border); }
.sec-chip  {
  font-size: 10.5px; font-weight: 700; color: var(--text-m);
  background: var(--surface); border: 1px solid var(--border);
  border-radius: 20px; padding: 3px 11px; box-shadow: var(--sh-xs);
}

/* ── SUMMARY HERO (desktop only) ── */
.desktop-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin-bottom: 30px;
}

.dh-card {
  border-radius: 22px;
  padding: 28px 28px 24px;
  position: relative; overflow: hidden;
  box-shadow: var(--sh-md);
}
.dh-card.rec-card {
  background: linear-gradient(135deg, #1d4ed8 0%, #4f46e5 50%, #7c3aed 100%);
}
.dh-card.dist-card-hero {
  background: linear-gradient(135deg, #b91c1c 0%, #dc2626 50%, #ef4444 100%);
}
.dh-card::before {
  content: ''; position: absolute; top: -50px; right: -50px;
  width: 200px; height: 200px; border-radius: 50%;
  background: rgba(255,255,255,0.07); pointer-events: none;
}
.dh-card::after {
  content: ''; position: absolute; bottom: -40px; left: -30px;
  width: 160px; height: 160px; border-radius: 50%;
  background: rgba(255,255,255,0.04); pointer-events: none;
}
.dh-label {
  font-size: 11px; font-weight: 700; letter-spacing: 1.2px;
  text-transform: uppercase; color: rgba(255,255,255,0.65);
  margin-bottom: 10px; display: flex; align-items: center; gap: 7px;
}
.dh-val {
  font-family: 'JetBrains Mono', monospace;
  font-size: 40px; font-weight: 700; color: #fff;
  letter-spacing: -2.5px; line-height: 1;
  margin-bottom: 5px;
}
.dh-sub {
  font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.5);
  margin-bottom: 0;
}

/* ── STATS GRID ── */
.sg {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(192px, 1fr));
  gap: 13px;
}

.sc {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r); padding: 20px 18px 17px;
  position: relative; overflow: hidden;
  box-shadow: var(--sh-sm); cursor: default;
  transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .22s ease;
}
.sc:hover { transform: translateY(-5px) scale(1.015); box-shadow: var(--sh-lg); }
.sc::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,.07) 55%, transparent 70%);
  transform: translateX(-120%); transition: transform .55s ease; pointer-events: none;
}
.sc:hover::before { transform: translateX(120%); }

.sc .strip { position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: var(--r) var(--r) 0 0; }
.sc .orb   { position: absolute; bottom: -20px; right: -20px; width: 80px; height: 80px; border-radius: 50%; opacity: .06; pointer-events: none; }

.sc .ic {
  width: 42px; height: 42px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; margin-bottom: 15px; position: relative; flex-shrink: 0;
}
.sc .ic::after {
  content: ''; position: absolute; inset: 0; border-radius: 12px;
  background: linear-gradient(165deg, rgba(255,255,255,.35) 0%, transparent 60%); pointer-events: none;
}

.sc .lbl { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .65px; color: var(--text-m); margin-bottom: 7px; }
.sc .val { font-family: 'JetBrains Mono', monospace; font-size: 25px; font-weight: 600; color: var(--text-h); letter-spacing: -1.5px; line-height: 1; }
.sc .cur { font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px; color: var(--text-m); text-transform: uppercase; margin-top: 7px; }

.c-blue  .strip { background: linear-gradient(90deg,#1d4ed8,#93c5fd); }
.c-blue  .ic    { background: linear-gradient(140deg,#dbeafe,#bfdbfe); color:#1e40af; }
.c-blue  .orb   { background:#2563eb; }
.c-red   .strip { background: linear-gradient(90deg,#b91c1c,#fca5a5); }
.c-red   .ic    { background: linear-gradient(140deg,#fee2e2,#fecaca); color:#991b1b; }
.c-red   .orb   { background:#dc2626; }
.c-green .strip { background: linear-gradient(90deg,#047857,#6ee7b7); }
.c-green .ic    { background: linear-gradient(140deg,#d1fae5,#a7f3d0); color:#065f46; }
.c-green .orb   { background:#059669; }
.c-amber .strip { background: linear-gradient(90deg,#b45309,#fde68a); }
.c-amber .ic    { background: linear-gradient(140deg,#fef3c7,#fde68a); color:#92400e; }
.c-amber .orb   { background:#d97706; }
.c-violet .strip { background: linear-gradient(90deg,#6d28d9,#c4b5fd); }
.c-violet .ic   { background: linear-gradient(140deg,#ede9fe,#ddd6fe); color:#5b21b6; }
.c-violet .orb  { background:#7c3aed; }

[data-theme="dark"] .c-blue  .ic { background:linear-gradient(140deg,rgba(37,99,235,.22),rgba(96,165,250,.1)); color:#60a5fa; }
[data-theme="dark"] .c-red   .ic { background:linear-gradient(140deg,rgba(185,28,28,.22),rgba(248,113,113,.1)); color:#f87171; }
[data-theme="dark"] .c-green .ic { background:linear-gradient(140deg,rgba(4,120,87,.22),rgba(52,211,153,.1)); color:#34d399; }
[data-theme="dark"] .c-amber .ic { background:linear-gradient(140deg,rgba(180,83,9,.22),rgba(253,230,138,.1)); color:#fbbf24; }
[data-theme="dark"] .c-violet .ic{ background:linear-gradient(140deg,rgba(109,40,217,.22),rgba(196,181,253,.1)); color:#a78bfa; }

/* ── ANALYTICS OVERVIEW ── */
.ao-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 13px; margin-bottom: 16px;
}

.ao-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r); padding: 20px 18px 17px;
  position: relative; overflow: hidden;
  box-shadow: var(--sh-sm);
  transition: transform .22s ease, box-shadow .22s ease;
}
.ao-card:hover { transform: translateY(-3px); box-shadow: var(--sh-md); }
.ao-card .ao-strip { position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: var(--r) var(--r) 0 0; }
.ao-card .ao-orb   { position: absolute; bottom: -20px; right: -20px; width: 80px; height: 80px; border-radius: 50%; opacity: .06; pointer-events: none; }
.ao-card .ao-ic {
  width: 42px; height: 42px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; margin-bottom: 14px; position: relative; flex-shrink: 0;
}
.ao-card .ao-ic::after {
  content: ''; position: absolute; inset: 0; border-radius: 12px;
  background: linear-gradient(165deg, rgba(255,255,255,.35) 0%, transparent 60%); pointer-events: none;
}
.ao-card .ao-lbl { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .65px; color: var(--text-m); margin-bottom: 7px; }
.ao-card .ao-val { font-family: 'JetBrains Mono', monospace; font-size: 24px; font-weight: 600; letter-spacing: -1.2px; line-height: 1; }
.ao-card .ao-cur { font-size: 9.5px; font-weight: 700; letter-spacing: 1.2px; color: var(--text-m); text-transform: uppercase; margin-top: 6px; }
.ao-card .ao-badge {
  display: inline-flex; align-items: center; gap: 4px;
  font-size: 10.5px; font-weight: 800; letter-spacing: .4px;
  border-radius: 20px; padding: 3px 10px;
  text-transform: uppercase; margin-top: 10px;
}

.badge-pos { background: rgba(5,150,105,.12);  color: #059669; }
.badge-neg { background: rgba(185,28,28,.12);   color: #b91c1c; }
.badge-neu { background: rgba(29,78,216,.10);   color: #1d4ed8; }

[data-theme="dark"] .badge-neu { color: #60a5fa; }
[data-theme="dark"] .badge-pos { color: #34d399; }
[data-theme="dark"] .badge-neg { color: #f87171; }

.ao-blue  .ao-strip { background: linear-gradient(90deg,#1d4ed8,#93c5fd); }
.ao-blue  .ao-ic    { background: linear-gradient(140deg,#dbeafe,#bfdbfe); color:#1e40af; }
.ao-blue  .ao-orb   { background:#2563eb; }
.ao-blue  .ao-val   { color: #1d4ed8; }
.ao-red   .ao-strip { background: linear-gradient(90deg,#b91c1c,#fca5a5); }
.ao-red   .ao-ic    { background: linear-gradient(140deg,#fee2e2,#fecaca); color:#991b1b; }
.ao-red   .ao-orb   { background:#dc2626; }
.ao-red   .ao-val   { color: #b91c1c; }
.ao-green .ao-strip { background: linear-gradient(90deg,#047857,#6ee7b7); }
.ao-green .ao-ic    { background: linear-gradient(140deg,#d1fae5,#a7f3d0); color:#065f46; }
.ao-green .ao-orb   { background:#059669; }
.ao-green .ao-val   { color: #047857; }
.ao-amber .ao-strip { background: linear-gradient(90deg,#b45309,#fde68a); }
.ao-amber .ao-ic    { background: linear-gradient(140deg,#fef3c7,#fde68a); color:#92400e; }
.ao-amber .ao-orb   { background:#d97706; }
.ao-amber .ao-val   { color: #b45309; }

[data-theme="dark"] .ao-blue  .ao-ic { background:linear-gradient(140deg,rgba(37,99,235,.22),rgba(96,165,250,.1)); color:#60a5fa; }
[data-theme="dark"] .ao-blue  .ao-val { color:#60a5fa; }
[data-theme="dark"] .ao-red   .ao-ic { background:linear-gradient(140deg,rgba(185,28,28,.22),rgba(248,113,113,.1)); color:#f87171; }
[data-theme="dark"] .ao-red   .ao-val { color:#f87171; }
[data-theme="dark"] .ao-green .ao-ic { background:linear-gradient(140deg,rgba(4,120,87,.22),rgba(52,211,153,.1)); color:#34d399; }
[data-theme="dark"] .ao-green .ao-val { color:#34d399; }
[data-theme="dark"] .ao-amber .ao-ic { background:linear-gradient(140deg,rgba(180,83,9,.22),rgba(253,230,138,.1)); color:#fbbf24; }
[data-theme="dark"] .ao-amber .ao-val { color:#fbbf24; }

.ao-card .ao-track  { height: 4px; border-radius: 10px; background: var(--border); margin-top: 12px; overflow: hidden; }
.ao-card .ao-fill   { height: 100%; border-radius: 10px; transition: width .8s cubic-bezier(.34,1.56,.64,1); }

/* ── CHARTS ── */
.charts-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.chart-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-lg); padding: 24px 24px 20px;
  box-shadow: var(--sh-sm);
  display: flex; flex-direction: column;
  transition: box-shadow .22s ease;
  min-width: 0; overflow: hidden;
}
.chart-card:hover { box-shadow: var(--sh-md); }

.cc-head {
  display: flex; align-items: flex-start;
  justify-content: space-between; gap: 12px; flex-wrap: wrap;
}
.cc-left { display: flex; align-items: center; gap: 14px; }

.cc-ico {
  width: 44px; height: 44px; border-radius: 13px;
  display: flex; align-items: center; justify-content: center;
  font-size: 17px; color: #fff; flex-shrink: 0; position: relative;
}
.cc-ico::after {
  content: ''; position: absolute; inset: 0; border-radius: 13px;
  background: linear-gradient(165deg, rgba(255,255,255,.28) 0%, transparent 55%); pointer-events: none;
}
.cc-ico.blue { background:linear-gradient(135deg,#1d4ed8,#60a5fa); box-shadow:0 6px 18px rgba(29,78,216,.35); }
.cc-ico.red  { background:linear-gradient(135deg,#b91c1c,#f87171); box-shadow:0 6px 18px rgba(185,28,28,.35); }

.cc-title { font-size: 15px; font-weight: 800; color: var(--text-h); letter-spacing: -.2px; }
.cc-sub   { font-size: 12px; color: var(--text-m); margin-top: 2px; font-weight: 500; }

.ptabs {
  display: flex;
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 10px; padding: 3px; gap: 2px; flex-shrink: 0;
}
.pt {
  padding: 6px 12px;
  font-size: 11px; font-weight: 700;
  color: var(--text-m);
  background: none; border: none; border-radius: 7px;
  cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif;
  transition: all .15s ease; white-space: nowrap;
}
.pt:hover { color: var(--text-h); }
.pt.active {
  background: var(--surface); color: var(--text-h);
  box-shadow: 0 2px 6px rgba(0,0,0,.10);
}
[data-theme="dark"] .pt.active { background:#222c42; box-shadow:0 2px 6px rgba(0,0,0,.3); }

.year-pills-row {
  display: flex; align-items: center; gap: 8px;
  margin-top: 12px; flex-wrap: wrap;
}
.year-label {
  font-size: 10px; font-weight: 700; text-transform: uppercase;
  letter-spacing: .7px; color: var(--text-m); white-space: nowrap;
  margin-right: 2px;
}
.ypill {
  padding: 4px 13px;
  font-size: 11px; font-weight: 700;
  color: var(--text-p);
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 20px; cursor: pointer;
  font-family: 'Plus Jakarta Sans', sans-serif;
  transition: all .15s ease; white-space: nowrap; letter-spacing: .3px;
}
.ypill:hover { background: var(--surface); color: var(--text-h); box-shadow: var(--sh-xs); }
.ypill.active {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff; border-color: transparent;
  box-shadow: 0 3px 10px rgba(29,78,216,.35);
}
.chart-card.dist-card .ypill.active {
  background: linear-gradient(135deg, #b91c1c, #ef4444);
  box-shadow: 0 3px 10px rgba(185,28,28,.35);
}

.month-pills-row {
  display: flex; align-items: center; gap: 6px;
  margin-top: 10px; flex-wrap: wrap;
}
.mpill {
  padding: 4px 10px;
  font-size: 10.5px; font-weight: 700;
  color: var(--text-p);
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 20px; cursor: pointer;
  font-family: 'Plus Jakarta Sans', sans-serif;
  transition: all .15s ease; white-space: nowrap; letter-spacing: .3px;
}
.mpill:hover { background: var(--surface); color: var(--text-h); }
.mpill.active {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff; border-color: transparent;
  box-shadow: 0 3px 10px rgba(29,78,216,.35);
}
.chart-card.dist-card .mpill.active {
  background: linear-gradient(135deg, #b91c1c, #ef4444);
  box-shadow: 0 3px 10px rgba(185,28,28,.35);
}

.cc-statbar {
  display: flex; margin: 14px 0 12px;
  background: var(--surface2); border: 1px solid var(--border);
  border-radius: 10px; overflow: hidden;
}
.csb {
  flex: 1; padding: 11px 13px;
  border-right: 1px solid var(--border);
  display: flex; flex-direction: column; gap: 4px;
}
.csb:last-child { border-right: none; }
.csb-lbl { font-size: 9.5px; font-weight: 700; text-transform: uppercase; letter-spacing: .7px; color: var(--text-m); }
.csb-val { font-family: 'JetBrains Mono', monospace; font-size: 13.5px; font-weight: 600; color: var(--text-h); letter-spacing: -.4px; }

.cc-scroll-outer {
  position: relative; overflow-x: auto; overflow-y: hidden;
  border-radius: 10px; height: 260px; flex-shrink: 0;
  scrollbar-width: thin; scrollbar-color: rgba(100,120,180,.25) transparent;
}
.cc-scroll-outer::-webkit-scrollbar { height: 5px; }
.cc-scroll-outer::-webkit-scrollbar-track { background: transparent; margin: 0 8px; }
.cc-scroll-outer::-webkit-scrollbar-thumb { background: rgba(100,120,180,.28); border-radius: 10px; }
.cc-scroll-outer::-webkit-scrollbar-thumb:hover { background: rgba(100,120,180,.55); }
[data-theme="dark"] .cc-scroll-outer::-webkit-scrollbar-thumb { background: rgba(100,140,220,.3); }

.cc-scroll-inner {
  display: flex; height: 100%; min-width: 100%; position: relative;
}
.cc-scroll-inner canvas { height: 100% !important; display: block; }

.scroll-hint {
  display: none; align-items: center; gap: 5px;
  font-size: 9.5px; font-weight: 700; color: var(--text-m);
